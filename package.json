{
  "name": "velnavoq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Velnavoq by Drayvenn Lab - isolated app builder control plane",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run target:build && vitest run",
    "check": "npm run typecheck && npm test && npm audit --audit-level=high",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply velnavoq-control --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "ui:dev": "vite",
    "ui:build": "tsc -p ui/tsconfig.json && vite build",
    "ui:test": "node scripts/ui-check.mjs",
    "navigation:test": "npm run build && node scripts/navigation-check.mjs",
    "target:build": "wrangler deploy --config deployment-target/wrangler.jsonc --dry-run --outdir ../target-dist",
    "quota:evidence": "node scripts/quota-evidence.mjs",
    "qa": "node scripts/qa-run.mjs all",
    "qa:report": "node scripts/qa-run.mjs report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "acorn": "8.15.0",
    "fflate": "0.8.3",
    "parse5": "8.0.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
