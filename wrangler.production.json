{
  "name": "velnavoq-control",
  "account_id": "bf803aa9551ec9003f00a3d27062a502",
  "main": "dist/index.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./ui-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/oauth/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_ORIGIN": "https://velnavoq-control.rajatkumarpradhan021.workers.dev",
    "AI_REPAIR_ENABLED": "true",
    "DEPLOY_MODE": "public",
    "DEPLOY_ORIGIN": "https://velnavoq-static-releases.rajatkumarpradhan021.workers.dev",
    "REGISTRATION_ENABLED": "true",
    "RUNTIME_ENABLED": "false",
    "SECRET_STORE_KEY_VERSION": "rebuild-v1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velnavoq-control",
      "database_id": "010c9e19-22b0-4b68-a2d7-f0d085984001"
    }
  ],
  "services": [
    {
      "binding": "DEPLOY_TARGET",
      "service": "velnavoq-static-releases"
    }
  ]
}
