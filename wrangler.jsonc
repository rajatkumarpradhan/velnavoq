{
  "name": "velnavoq-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./ui-dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/oauth/*","/mcp","/mcp/*","/.well-known/*"]},
  "ai": {"binding":"AI"},
  "vars": {"APP_ORIGIN":"http://localhost:8787", "REGISTRATION_ENABLED":"false", "RUNTIME_ENABLED":"false", "AI_REPAIR_ENABLED":"false"},
  "d1_databases": [{"binding":"DB","database_name":"velnavoq-control","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
